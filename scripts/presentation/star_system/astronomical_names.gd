static func system_name(seed_value: int, number: int) -> String:
	var order: Array = NAMES.duplicate()
	var rng = RandomNumberGenerator.new()
	rng.seed = hash("%d:system-names-v1" % seed_value)
	for i in range(order.size() - 1, 0, -1):
		var j: int = rng.randi_range(0, i)
		var value: String = order[i]
		order[i] = order[j]
		order[j] = value
	return order[posmod(number - 1, order.size())]
