extends SceneTree
# Controlled fixtures deliberately bypass six-encounter generation only for stress cases.
const State = preload("res://scripts/expedition_state.gd")
const Rules = preload("res://encounters/expedition_rules.tres")
const Ships = preload("res://scripts/ship_library.gd")
const Hand = preload("res://scripts/card_hand.gd")
const Board = preload("res://scenes/board_3d.tscn")
const OUTCOME_KEYS = ["salvage", "hull", "next_battle", "card_reward", "minimum_card_tier", "upgrade_card", "resource_choice", "production_choice", "extra_ftl_charge"]
var failures: int = 0
var checks: int = 0
var report: String = "# Expedition reward verification\n\nGenerated by `tests/poi_reward_overhaul_test.gd` with Godot's actual board, hand draw rules, card costs and first-turn production. Enemy profiles are hypothetical player baselines; no shipped statistics change.\n\n"
class ProfileState extends State:
	var profile: Resource
	func ship() -> Resource:
		return profile if profile != null else super.ship()

func check(ok: bool, message: String) -> void:
	checks += 1
	if not ok:
		failures += 1
		push_error(message)

func fresh(profile: Resource = Ships.PLAYERS[0]) -> Resource:
	var run = ProfileState.new()
	run.profile = profile
	var config = Rules.duplicate(true)
	config.log_rolls = false
	run.start(0, config, 1234)
	return run

func settle_choice(run: Resource) -> void:
	if run.pending_choice == "card":
		check(run.choose_card(0) and not run.choose_card(0), "Card selection is single-use")
	elif run.pending_choice == "upgrade":
		var key: String = run.upgrade_candidates()[0].identity_key()
		check(run.choose_upgrade(key) and not run.choose_upgrade(key), "Upgrade selection is single-use")

func check_tables() -> void:
	var expected: Dictionary = JSON.parse_string(FileAccess.get_file_as_string("res://tests/poi_reward_table.json"))
	check(Rules.pois.size() == 10 and Rules.trading_outpost not in Rules.pois, "Ten PoIs, service separate")
	for poi in Rules.pois:
		var rows: Array = expected[poi.resource_path.get_file().get_basename()]
		for slot in range(4):
			var approach: Resource = poi.approaches[slot]
			check(is_equal_approx(approach.success_chance, rows[slot][0]), "Exact success chance")
			for branch in range(2):
				var outcome: Resource = approach.success if branch == 0 else approach.failure
				var values: Dictionary = rows[slot][branch + 1]
				for key in OUTCOME_KEYS:
					var fallback: Variant = {} if key == "next_battle" else (false if key in ["card_reward", "upgrade_card"] else (1 if key == "minimum_card_tier" else 0))
					# JSON numbers are floats; compare dictionary values numerically.
					if key == "next_battle":
						var modifiers: Dictionary = values.get(key, {})
						check(outcome.next_battle.size() == modifiers.size(), "Exact modifier keys")
						for attribute in modifiers: check(outcome.next_battle.get(attribute) == modifiers[attribute], "Exact reward modifier")
					else: check(outcome.get(key) == values.get(key, fallback), "Exact reward " + key)
				for key in State.PRODUCTION: check(not outcome.next_battle.has(key), "No temporary production effects")
				var run = fresh()
				run.salvage = 100
				run.hull = 10
				for key in State.PRODUCTION: run.production_upgrades[key] = 3
				run.encounters.assign([{"kind":"poi", "poi":poi, "completed":false}])
				var roll: float = 0.0 if branch == 0 else 0.99999
				var rolled: Resource = approach.success if roll < approach.success_chance else approach.failure
				check(run.resolve_approach(0, slot, roll), "Reward branch resolves")
				check(run.salvage == 100 - approach.salvage_cost + rolled.salvage and run.hull == 10 + rolled.hull, "Exact immediate rewards")
				check(run.ftl_charge == 1 + rolled.extra_ftl_charge, "Exact travel charge")
				settle_choice(run)
				var before: int = run.salvage
				check(not run.resolve_approach(0, slot, roll) and run.salvage == before, "Cannot duplicate resolved rewards")

func board_for(run: Resource) -> Node:
	var board = Board.instantiate()
	# Setting the Resource directly also exercises the three hypothetical enemy baselines.
	board.player_ship_data = run.ship()
	board.enemy_ship_data = Ships.ENEMIES[0]
	board.setup_settings = {"modifier":0}
	board.expedition = run
	for index in range(run.encounters.size()):
		if run.encounters[index].kind == "battle":
			board.expedition_encounter = index
			break
	board.get_node("BattleEffects").enabled = false
	board.get_node("CardMotion").settings = board.get_node("CardMotion").settings.duplicate()
	board.get_node("CardMotion").settings.enabled = false
	root.add_child(board)
	return board

func measure(run: Resource, scenario: String) -> void:
	var expected: Dictionary = {}
	for key in State.RESOURCES:
		var base: int = run.ship().get(key)
		var positive: int = run.pending_bonuses.get(key, 0)
		var negative: int = run.pending_penalties.get(key, 0)
		expected[key] = maxi(0, base + positive - mini(absi(negative), floori(base * 0.5))) + run.production(State.PRODUCTION[State.RESOURCES.find(key)])
	var board = board_for(run)
	for key in State.RESOURCES: check(board.get("player_" + key) == expected[key], "Exact post-income resource formula")
	for key in State.PRODUCTION: check(board.get("player_" + key) == run.production(key), "Production income preserved")
	check(run.pending_bonuses.is_empty() and run.pending_penalties.is_empty(), "Consume on battle entry only")
	var before: Dictionary = board._read_state("player")
	run.begin_battle(board)
	check(board._read_state("player") == before, "Repeated initialization cannot reset or reapply")
	run.add_modifiers({"energy":3})
	run.begin_battle(board)
	check(run.modifier_value("energy") == 3 and board._read_state("player") == before, "Repeated entry cannot consume rewards queued for a later battle")
	var hand = Hand.new()
	hand.card_pool = run.player_pool()
	var minimum: int = 6
	var total: int = 0
	var empty: int = 0
	var max_wait: int = 0
	for seed_value in range(1, 513):
		hand.rng.seed = seed_value
		hand.deal(6)
		var affordable: int = 0
		var wait_turns: int = 999
		for card in hand.cards:
			check(card != null and card.tier == 1, "Actual opening draw obeys tier lock")
			var available: int = board.get("player_" + card.family)
			if card.cost <= available: affordable += 1
			var production: int = board.get("player_" + State.PRODUCTION[State.RESOURCES.find(card.family)])
			if production > 0: wait_turns = mini(wait_turns, ceili(float(maxi(0, card.cost - available)) / production))
		minimum = mini(minimum, affordable)
		total += affordable
		if affordable == 0: empty += 1
		max_wait = maxi(max_wait, wait_turns)
	report += "| %s | %s | %d/%d/%d | %d | %.2f | %d/512 | %d |\n" % [run.ship().ship_name, scenario, expected.materials, expected.energy, expected.crew, minimum, total / 512.0, empty, max_wait]
	hand.free()
	board.free()

func sequence(profile: Resource, count: int, success: bool) -> Resource:
	var run = fresh(profile)
	# Four ordinary PoIs and one hazard before one battle, controlled order and rolls.
	run.encounters.clear()
	for n in range(count):
		var poi: Resource = Rules.pois[n] if n < 4 else load("res://encounters/radiation_nebula.tres")
		run.encounters.append({"kind":"poi", "poi":poi, "completed":false})
	run.encounters.append({"kind":"battle", "enemy":0, "completed":false})
	for n in range(count):
		check(run.resolve_approach(n, 1, 0.0 if success else 0.99999), "Controlled five-PoI route")
		settle_choice(run)
	return run

func services_and_navigation() -> void:
	var run = fresh()
	while run.service.is_empty():
		run.ftl_charge = run.required_ftl_charge
		check(run.generate_system(), "Reach scheduled service station")
	var requirement: int = run.required_ftl_charge
	var remaining: int = run.remaining_ftl_charge()
	check(run.encounters.size() == 6 and run.can_visit(State.SERVICE_INDEX), "Six encounters plus accessible service")
	check(not run.can_survey(State.SERVICE_INDEX) and not run.survey(State.SERVICE_INDEX), "Service never uses survey")
	for slot in range(4): check(not run.purchase_service(slot, run.service_revision, 1), "Zero Salvage cannot buy")
	check(run.ftl_charge == 0 and run.required_ftl_charge == requirement and run.remaining_ftl_charge() == remaining and run.pending_penalties.is_empty(), "Declining service changes no accounting")
	for slot in range(4):
		run.salvage = 30
		run.hull = run.ship().hull_capacity - 5
		var price: int = [5,7,15,25][slot]
		check(run.purchase_service(slot, run.service_revision, 5), "Purchase service")
		check(run.salvage == 30 - price and run.ftl_charge == 0 and run.required_ftl_charge == requirement and run.remaining_ftl_charge() == remaining, "Service exact price; zero charge/capacity change")
		if slot == 0: check(run.hull == run.ship().hull_capacity, "Repair five")
		if slot == 1:
			check(run.choose_attribute("materials") and not run.choose_attribute("materials") and run.modifier_value("materials") == 5, "Supply choice once")
		if slot == 2: settle_choice(run)
		if slot == 3:
			var before: int = run.production("reactor")
			check(run.choose_attribute("reactor") and not run.choose_attribute("reactor") and run.production("reactor") == before + 1, "Permanent upgrade once")
		check(run.can_visit(State.SERVICE_INDEX), "Service remains available after purchase")
	run = fresh()
	run.hull = 1
	run.encounters.assign([{"kind":"poi", "poi":load("res://encounters/pirate_debris_field.tres"), "completed":false}])
	run.required_ftl_charge = 1
	check(run.survey(0) and run.hull == 1 and run.salvage == 0 and run.modifier_value("energy") == -3 and run.can_jump(), "One Hull, zero Salvage survey preserves travel")
	check(not run.survey(0) and run.modifier_value("energy") == -3, "Survey cannot duplicate")
	run = fresh()
	run.ftl_charge = run.required_ftl_charge
	check(run.can_jump() and run.generate_system(), "Unused station never blocks departure")

func _initialize() -> void:
	call_deferred("run_tests")

func run_tests() -> void:
	check_tables()
	services_and_navigation()
	report += "Each row samples 512 deterministic six-card opening hands. M/E/C includes first-turn income. Wait is the maximum additional normal player turns until at least one held card is affordable, assuming no card plays, damage or events. This measures affordability, not combat win rate.\n\n| Ship | Controlled scenario | Opening M/E/C | Min affordable | Mean affordable | No affordable cards | Max wait |\n|---|---|---|---|---|---|---|\n"
	var profiles: Array = Ships.PLAYERS.duplicate()
	profiles.append_array(Ships.ENEMIES)
	for profile in profiles:
		measure(sequence(profile, 5, true), "5 successes")
		measure(sequence(profile, 5, false), "5 failures")
		# Independent per-attribute extrema from all authored outcomes, ten applications each.
		# This is an artificial upper/lower envelope, not a legal ten-stop generated system.
		for positive in [true, false]:
			var run = fresh(profile)
			var extrema: Dictionary = {}
			for poi in Rules.pois:
				for approach in poi.approaches:
					for outcome in [approach.success, approach.failure]:
						for key in outcome.next_battle:
							if key == "emergency_jump_offline": continue
							var amount: int = outcome.next_battle[key]
							extrema[key] = maxi(extrema.get(key, 0), amount) if positive else mini(extrema.get(key, 0), amount)
			for n in range(10): run.add_modifiers(extrema)
			measure(run, "10-PoI max " + ("bonuses" if positive else "penalties"))
		var run = fresh(profile)
		for n in range(10):
			run.add_modifiers({"materials":3, "energy":2, "crew":1, "shields":2, "emergency_jump_charge":5, "emergency_jump_offline":1})
			run.add_modifiers({"materials":-12, "energy":-12, "crew":-12, "shields":-3, "emergency_jump_offline":2})
		check(run.modifier_value("materials") == -90 and run.modifier_value("emergency_jump_offline") == 2, "Signed totals and longest offline")
		var shield_start: int = maxi(0, profile.shields - 10)
		var board = board_for(run)
		check(board.player_shields == shield_start and board.ftl.charge == profile.ftl_turns and board.ftl.disabled_turns == 2, "Stacked Shields, ship charge cap, longest offline")
		board.ftl.begin_player_turn()
		check(board.ftl.disabled_turns == 1, "Second turn offline")
		board.ftl.begin_player_turn()
		check(board.ftl.disabled_turns == 0 and board.ftl.can_warp(), "Third turn online")
		board.free()
		run = fresh(profile)
		run.add_modifiers({"materials":3})
		run.add_modifiers({"materials":-12})
		check(run.starting_value(profile, "materials") == profile.materials + 3 - floori(profile.materials * 0.5), "Mixed modifiers use unmodified cap")
		measure(run, "mixed +3 / -12 Materials")
	var example: Resource = Ships.PLAYERS[0].duplicate()
	example.materials = 8
	var example_run = fresh(example)
	example_run.add_modifiers({"materials":3})
	example_run.add_modifiers({"materials":-12})
	check(example_run.starting_value(example, "materials") == 7, "Specified base eight example")
	# Explicit odd baseline verifies integer floor without modifying shipped Resources.
	var odd: Resource = Ships.PLAYERS[0].duplicate()
	odd.materials = 7
	var run = fresh(odd)
	run.add_modifiers({"materials":-99})
	check(run.starting_value(odd, "materials") == 4, "Odd base floors penalty cap")
	if "--write-report" in OS.get_cmdline_user_args():
		var file = FileAccess.open("res://docs/balance/reward_verification.md", FileAccess.WRITE)
		file.store_string(report + "\nThe ten-PoI rows independently combine per-attribute authored extrema and repeat ten times; they are stress envelopes, not generator output. Materials has no ordinary PoI positive reward in this table (outpost supplies are tested separately). Bonuses remain uncapped by design. Acquired Uncommon cards remain unavailable in opening hands under the existing tier lock.\n")
	print("PoI reward overhaul: %d checks, %d failures" % [checks, failures])
	quit(1 if failures else 0)
