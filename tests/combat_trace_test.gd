var trace: Array = []

func outcome(states: Array, clock: RefCounted) -> String:
	trace.append([states.duplicate(true), clock.remaining.duplicate(true)])
	return super.outcome(states, clock)

func run() -> void:
	var index: int = 0
	for player in Ships.PLAYERS:
		for kind in range(6):
			for seed_value in [1, 7]:
				trace = []
				var record: Dictionary = play_match(player, Config.enemy_ships[0], kind, seed_value)
				var digest: String = JSON.stringify({"record": record, "trace": trace}).sha256_text()
				assert(digest == EXPECTED[index], "Trace mismatch: %s modifier %d seed %d" % [player.ship_name, kind, seed_value])
				index += 1
	print("Combat trace parity: %d exact baseline traces passed" % index)
	quit()
