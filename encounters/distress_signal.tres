title = "Relay coordinates"
success = SubResource("Success0")
failure = SubResource("Failure0")

[sub_resource type="Resource" id="Failure1"]
script = ExtResource("Outcome")
blurb = "No survivors remain; the search still recovers supplies."
salvage = 2
next_battle = {
"crew": -4
}

[sub_resource type="Resource" id="Success1"]
script = ExtResource("Outcome")
blurb = "The survivors share a useful schematic."
salvage = 5
next_battle = {
"crew": -2
}
card_reward = true

[sub_resource type="Resource" id="Approach1"]
script = ExtResource("Approach")
title = "Dispatch rescue crew"
success_chance = 0.7
success = SubResource("Success1")
failure = SubResource("Failure1")

[sub_resource type="Resource" id="Failure2"]
script = ExtResource("Outcome")
blurb = "Your crew recovers only the cargo."
salvage = 3
next_battle = {
"crew": -4
}

[sub_resource type="Resource" id="Success2"]
script = ExtResource("Outcome")
blurb = "Your trained teams recover an uncommon schematic."
salvage = 7
next_battle = {
"crew": -2
}
card_reward = true
minimum_card_tier = 2

[sub_resource type="Resource" id="Approach2"]
script = ExtResource("Approach")
title = "Specialist rescue"
requirement = "quarters"
success_chance = 0.85
success = SubResource("Success2")
failure = SubResource("Failure2")

[sub_resource type="Resource" id="Failure3"]
script = ExtResource("Outcome")
blurb = "Relief work earns valuable equipment."
salvage = 8
next_battle = {
"crew": 3,
"materials": -4
}

[sub_resource type="Resource" id="Success3"]
script = ExtResource("Outcome")
blurb = "Relief work earns valuable equipment."
salvage = 8
next_battle = {
"crew": 3,
"materials": -4
}

[sub_resource type="Resource" id="Approach3"]
script = ExtResource("Approach")
title = "Fabricate relief kits"
