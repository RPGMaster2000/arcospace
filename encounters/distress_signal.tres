[ext_resource type="Script" uid="uid://c7nkepq0ocquq" path="res://scripts/expedition/encounter_outcome.gd" id="Outcome"]
[ext_resource type="Script" uid="uid://micrk5gbrjhc" path="res://scripts/expedition/poi_data.gd" id="Poi"]

[sub_resource type="Resource" id="Failure0"]
