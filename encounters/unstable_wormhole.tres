next_battle = {
"emp_pulse_offline": 1
}

[sub_resource type="Resource" id="Success0"]
script = ExtResource("Outcome")
blurb = "Your safe-distance survey disrupts EMP Pulse calibration."
salvage = 3
next_battle = {
"emp_pulse_offline": 1
}

[sub_resource type="Resource" id="Approach0"]
script = ExtResource("Approach")
title = "Map the perimeter"
success = SubResource("Success0")
failure = SubResource("Failure0")

[sub_resource type="Resource" id="Failure1"]
script = ExtResource("Outcome")
blurb = "The probe maps only the perimeter and strains shielding."
salvage = 2
next_battle = {
"shields": -8
}

[sub_resource type="Resource" id="Success1"]
script = ExtResource("Outcome")
blurb = "The shortcut contributes extra interstellar charge."
salvage = 5

[sub_resource type="Resource" id="Approach1"]
script = ExtResource("Approach")
title = "Probe the shortcut"
success_chance = 0.4
success = SubResource("Success1")
failure = SubResource("Failure1")

[sub_resource type="Resource" id="Failure2"]
script = ExtResource("Outcome")
blurb = "The corridor closes after its first readings."
salvage = 3
next_battle = {
"emp_pulse_offline": 3
}

[sub_resource type="Resource" id="Success2"]
script = ExtResource("Outcome")
blurb = "A stable corridor supplies one extra travel charge."
salvage = 7

[sub_resource type="Resource" id="Approach2"]
script = ExtResource("Approach")
title = "Stabilize corridor"
requirement = "reactor"
minimum_production = 4
success_chance = 0.5
success = SubResource("Success2")
failure = SubResource("Failure2")

[sub_resource type="Resource" id="Failure3"]
script = ExtResource("Outcome")
blurb = "The probe drains energy reserves, but a few valuable readings survive."
salvage = 4
next_battle = {
"energy": -8
}

[sub_resource type="Resource" id="Success3"]
script = ExtResource("Outcome")
blurb = "The reinforced probe charts a shortcut and recovers valuable readings."
salvage = 9

[sub_resource type="Resource" id="Approach3"]
script = ExtResource("Approach")
title = "Reinforce transit probe"
requirement = "synthesizer"
success_chance = 0.45
success = SubResource("Success3")
failure = SubResource("Failure3")

[resource]
script = ExtResource("Poi")
title = "Unstable Wormhole"
description = "Risk reserve penalties or EMP Pulse disruption for a chance at one extra travel charge."
approaches = Array[ExtResource("Approach")]([SubResource("Approach0"), SubResource("Approach1"), SubResource("Approach2"), SubResource("Approach3")])
hazardous = true
