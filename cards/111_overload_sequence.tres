description = "Enemy Shields already zero: 24 damage, +6 Crew. Else remove 20 Shields, then deal 10 damage."
effects = {"conditional": {"target": "enemy", "attribute": "shields", "comparison": "equal", "threshold": 0, "then": {"damage": 24, "crew": 6}, "else": {"break_shields": 20, "damage": 10}}}
upgrade_effects = Array[Dictionary]([{"conditional": {"target": "enemy", "attribute": "shields", "comparison": "equal", "threshold": 0, "then": {"damage": 27, "crew": 7}, "else": {"break_shields": 23, "damage": 12}}}, {"conditional": {"target": "enemy", "attribute": "shields", "comparison": "equal", "threshold": 0, "then": {"damage": 30, "crew": 8}, "else": {"break_shields": 26, "damage": 14}}}])
