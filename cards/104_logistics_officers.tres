[gd_resource type="Resource" script_class="CardData" format=3]

[ext_resource type="Script" path="res://scripts/cards/card_data.gd" id="1"]

[resource]
script = ExtResource("1")
card_name = "Logistics Officers"
tier = 2
family = "crew"
cost = 13
allocation_category = "systems"
description = "At 4+ Quarters: +8 Materials and Energy each. Else +1 Quarters and +4 of each."
effects = {"conditional": {"target": "self", "attribute": "quarters", "comparison": "at_least", "threshold": 4, "then": {"materials": 8, "energy": 8}, "else": {"quarters": 1, "materials": 4, "energy": 4}}}
upgrade_effects = Array[Dictionary]([{"conditional": {"target": "self", "attribute": "quarters", "comparison": "at_least", "threshold": 4, "then": {"materials": 10, "energy": 10}, "else": {"quarters": 1, "materials": 5, "energy": 5}}}, {"conditional": {"target": "self", "attribute": "quarters", "comparison": "at_least", "threshold": 4, "then": {"materials": 12, "energy": 12}, "else": {"quarters": 1, "materials": 6, "energy": 6}}}])
