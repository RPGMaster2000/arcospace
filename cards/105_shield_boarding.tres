[gd_resource type="Resource" script_class="CardData" format=3]

[ext_resource type="Script" path="res://scripts/cards/card_data.gd" id="1"]

[resource]
script = ExtResource("1")
card_name = "Shield Boarding"
tier = 2
family = "crew"
cost = 14
allocation_category = "offense"
description = "Steal up to 5 Energy. At 10+ enemy Shields, remove 12 Shields. Else deal 8 piercing damage."
effects = {"steal": {"energy": 5}, "conditional": {"target": "enemy", "attribute": "shields", "comparison": "at_least", "threshold": 10, "then": {"break_shields": 12}, "else": {"damage": 8, "pierce": 1.0}}}
upgrade_effects = Array[Dictionary]([{"steal": {"energy": 6}, "conditional": {"target": "enemy", "attribute": "shields", "comparison": "at_least", "threshold": 10, "then": {"break_shields": 14}, "else": {"damage": 10, "pierce": 1.0}}}, {"steal": {"energy": 7}, "conditional": {"target": "enemy", "attribute": "shields", "comparison": "at_least", "threshold": 10, "then": {"break_shields": 16}, "else": {"damage": 12, "pierce": 1.0}}}])
